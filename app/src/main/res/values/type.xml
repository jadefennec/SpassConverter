<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextAppearance.SPass" parent="android:TextAppearance.Material.Body1">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.SPass.AppTitle" parent="TextAppearance.SPass">
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textSize">23sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.SPass.AppSubtitle" parent="TextAppearance.SPass">
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <style name="TextAppearance.SPass.Label" parent="TextAppearance.SPass">
        <item name="android:fontFamily">@font/dm_mono</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/text_label</item>
    </style>

    <style name="TextAppearance.SPass.UploadBody" parent="TextAppearance.SPass">
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.SPass.UploadHint" parent="TextAppearance.SPass">
        <item name="android:fontFamily">@font/dm_mono</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/text_hint_color</item>
    </style>

    <style name="TextAppearance.SPass.BtnPrimary" parent="TextAppearance.SPass">
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/btn_primary_text</item>
    </style>

    <style name="TextAppearance.SPass.BtnSecondary" parent="TextAppearance.SPass">
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/btn_secondary_text</item>
    </style>

    <style name="TextAppearance.SPass.Disclaimer" parent="TextAppearance.SPass">
        <item name="android:fontFamily">@font/dm_mono</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textColor">@color/text_disclaimer</item>
        <item name="android:lineSpacingMultiplier">1.7</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="TextAppearance.SPass.SuccessTitle" parent="TextAppearance.SPass">
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_success_title</item>
    </style>

    <style name="TextAppearance.SPass.SuccessSub" parent="TextAppearance.SPass">
        <item name="android:fontFamily">@font/dm_mono</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textColor">@color/text_success_sub</item>
    </style>

    <style name="TextAppearance.SPass.StatNum" parent="TextAppearance.SPass">
        <item name="android:fontFamily">@font/dm_mono</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_stat_num</item>
    </style>

    <style name="TextAppearance.SPass.StatLabel" parent="TextAppearance.SPass">
        <item name="android:fontFamily">@font/dm_mono</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.10</item>
        <item name="android:textColor">@color/text_stat_label</item>
    </style>

    <style name="TextAppearance.SPass.FileName" parent="TextAppearance.SPass">
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_file_name</item>
    </style>

    <style name="TextAppearance.SPass.FileMeta" parent="TextAppearance.SPass">
        <item name="android:fontFamily">@font/dm_mono</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/text_file_meta</item>
    </style>

    <style name="TextAppearance.SPass.PrivacyNote" parent="TextAppearance.SPass">
        <item name="android:fontFamily">@font/dm_mono</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:textColor">@color/text_privacy</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>

</resources>
